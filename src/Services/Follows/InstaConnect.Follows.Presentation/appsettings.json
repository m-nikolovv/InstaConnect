{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" }
        ],
        "Enrich": [ "WithMachineName", "WithProcessId", "WithThreadId" ]
    },

    "AccessTokenConfiguration": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkewSeconds": 0,
        "LifetimeSeconds": 900
    },

    "FollowConfiguration": {
        "HubRoute": "/hubs/follows"
    },

    "KafkaConfiguration": {
        "Consumers": {
            "user-added-event-request": {
                "PartitionCount": 1,
                "ReplicationFactor": 1,
                "RetryLimit": 1,
                "RetryMinInterval": "00:00:00.200",
                "RetryMaxInterval": "00:00:10",
                "RetryIntervalDelta": "00:00:00.200"
            },
            "user-updated-event-request": {
                "PartitionCount": 1,
                "ReplicationFactor": 1,
                "RetryLimit": 1,
                "RetryMinInterval": "00:00:00.200",
                "RetryMaxInterval": "00:00:10",
                "RetryIntervalDelta": "00:00:00.200"
            },
            "user-deleted-event-request": {
                "PartitionCount": 1,
                "ReplicationFactor": 1,
                "RetryLimit": 1,
                "RetryMinInterval": "00:00:00.200",
                "RetryMaxInterval": "00:00:10",
                "RetryIntervalDelta": "00:00:00.200"
            }
        }
    }
}
