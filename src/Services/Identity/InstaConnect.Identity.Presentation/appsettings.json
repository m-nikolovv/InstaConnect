{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",

	"Serilog": {
		"Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Information"
			}
		},
		"WriteTo": [
			{ "Name": "Console" }
		],
		"Enrich": [ "WithMachineName", "WithProcessId", "WithThreadId" ]
	},

	"AccessTokenConfiguration": {
		"ValidateIssuer": true,
		"ValidateAudience": true,
		"ValidateLifetime": true,
		"ValidateIssuerSigningKey": true,
		"ClockSkewSeconds": 0,
		"LifetimeSeconds": 900
	},

	"EmailConfirmationTokenConfiguration": {
		"LifetimeSeconds": 10000
	},

	"ForgotPasswordTokenConfiguration": {
		"LifetimeSeconds": 10000
	},

	"RefreshTokenConfiguration": {
		"LifetimeSeconds": 10000
	},

	"AdminConfiguration": {
		"Name": "AdminName",
		"FirstName": "AdminFirstName",
		"LastName": "AdminLastName"
	},

	"RateLimiterPolicyConfiguration": {
		"PermitLimit": 100,
		"Window": "00:00:10",
		"SegmentsPerWindow": 5
	},

	"OutboxEventConfiguration": {
		"LifetimeSeconds": 86400
	},

	"EmailConfirmationTokenCacheConfiguration": {
		"Expirations": {
			"identity-email-confirmation-tokens-get-by-id": "00:25:00",
			"identity-email-confirmation-tokens-exists-by-id": "00:25:00"
		}
	},

	"ForgotPasswordTokenCacheConfiguration": {
		"Expirations": {
			"identity-forgot-password-tokens-get-by-id": "00:25:00",
			"identity-forgot-password-tokens-exists-by-id": "00:25:00"
		}
	},

	"RefreshTokenCacheConfiguration": {
		"Expirations": {
			"identity-refresh-tokens-get-by-id": "00:25:00"
		}
	},

	"UserClaimCacheConfiguration": {
		"Expirations": {
			"identity-user-claims-get-by-id": "00:25:00",
			"identity-user-claims-exists-by-id": "00:25:00",
			"identity-user-claims-get-by-id-response": "00:25:00"
		}
	},

	"UserCacheConfiguration": {
		"Expirations": {
			"identity-users-get-by-id": "00:25:00",
			"identity-users-exists-by-id": "00:25:00",
			"identity-users-get-by-name": "00:25:00",
			"identity-users-get-by-email": "00:25:00",
			"identity-users-get-by-id-response": "00:25:00"
		}
	},

	"KafkaConfiguration": {
		"SecurityProtocol": "SaslPlaintext",
		"SaslMechanism": "Plain"
	}
}
