{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" }
        ],
        "Enrich": [ "WithMachineName", "WithProcessId", "WithThreadId" ]
    },

    "AccessTokenConfiguration": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkewSeconds": 0,
        "LifetimeSeconds": 900
    },

    "ChatMessageConfiguration": {
        "HubRoute": "/hubs/chat-messages"
    },

    "RateLimiterPolicyConfiguration": {
        "PermitLimit": 100,
        "Window": "00:00:10",
        "SegmentsPerWindow": 5
    },

    "OutboxEventConfiguration": {
        "LifetimeSeconds": 86400
    },

    "ChatMessageImageCacheConfiguration": {
        "Expirations": {
            "chats-chat-message-images-get-by-id": "00:25:00"
        }
    },

    "ChatMessageCacheConfiguration": {
        "Expirations": {
            "chats-chat-messages-get-by-id": "00:25:00",
            "chats-chat-messages-exists-by-id": "00:25:00",
            "chats-chat-messages-get-by-id-response": "00:25:00"
        }
    },

    "ChatCacheConfiguration": {
        "Expirations": {
            "chats-chats-get-by-id": "00:25:00",
            "chats-chats-exists-by-id": "00:25:00",
            "chats-chats-get-by-id-response": "00:25:00"
        }
    },

    "UserCacheConfiguration": {
        "Expirations": {
            "chats-users-get-by-id": "00:25:00",
            "chats-users-exists-by-id": "00:25:00",
            "chats-users-get-by-name": "00:25:00",
            "chats-users-get-by-email": "00:25:00",
            "chats-users-get-by-id-response": "00:25:00"
        }
    },

    "UserEventHandlerConfiguration": {
        "Consumers": {
            "user-added-event-request": {
                "PartitionCount": 6,
                "ReplicationFactor": 1,
                "ConcurrentMessageLimit": 10,
                "Retry": {
                    "Limit": 5,
                    "MinInterval": "00:00:00.200",
                    "MaxInterval": "00:00:10",
                    "IntervalDelta": "00:00:00.200"
                }
            },
            "user-updated-event-request": {
                "PartitionCount": 6,
                "ReplicationFactor": 1,
                "ConcurrentMessageLimit": 10,
                "Retry": {
                    "Limit": 5,
                    "MinInterval": "00:00:00.200",
                    "MaxInterval": "00:00:10",
                    "IntervalDelta": "00:00:00.200"
                }
            },
            "user-deleted-event-request": {
                "PartitionCount": 6,
                "ReplicationFactor": 1,
                "ConcurrentMessageLimit": 10,
                "Retry": {
                    "Limit": 5,
                    "MinInterval": "00:00:00.200",
                    "MaxInterval": "00:00:10",
                    "IntervalDelta": "00:00:00.200"
                }
            }
        }
    },

    "KafkaConfiguration": {
        "SecurityProtocol": "SaslPlaintext",
        "SaslMechanism": "Plain"
    }
}
