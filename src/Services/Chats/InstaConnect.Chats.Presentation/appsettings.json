{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" }
        ],
        "Enrich": [ "WithMachineName", "WithProcessId", "WithThreadId" ]
    },

    "AccessTokenConfiguration": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkewSeconds": 0,
        "LifetimeSeconds": 900
    },

    "ChatMessageConfiguration": {
        "HubRoute": "/hubs/chat-messages"
    },

    "KafkaConfiguration": {
        "Consumers": {
            "user-added-event-request": {
                "PartitionCount": 6,
                "ReplicationFactor": 1,
                "ConcurrentMessageLimit": 10,
                "Retry": {
                    "Limit": 5,
                    "MinInterval": "00:00:00.200",
                    "MaxInterval": "00:00:10",
                    "IntervalDelta": "00:00:00.200"
                }
            },
            "user-updated-event-request": {
                "PartitionCount": 6,
                "ReplicationFactor": 1,
                "ConcurrentMessageLimit": 10,
                "Retry": {
                    "Limit": 5,
                    "MinInterval": "00:00:00.200",
                    "MaxInterval": "00:00:10",
                    "IntervalDelta": "00:00:00.200"
                }
            },
            "user-deleted-event-request": {
                "PartitionCount": 6,
                "ReplicationFactor": 1,
                "ConcurrentMessageLimit": 10,
                "Retry": {
                    "Limit": 5,
                    "MinInterval": "00:00:00.200",
                    "MaxInterval": "00:00:10",
                    "IntervalDelta": "00:00:00.200"
                }
            }
        }
    }
}
